# IN-list elements written as expressions — TPC-DS writes `d_year IN (1999, 1999+1, 1999+2)`.
# The list is built at parse time, before the binder runs, so each non-literal element is
# bound and folded natively there. When constant folding went native-only these were
# refused (TPC-DS Q23, Q29, Q34, Q46, Q53, Q63, Q68, Q73, Q74, Q79).

query I
SELECT id FROM $planets WHERE id IN (1, 1 + 1) ORDER BY id
----
1
2

query I
SELECT id FROM $planets WHERE id IN (2 * 2, 10 - 1) ORDER BY id
----
4
9

# The TPC-DS shape: a literal followed by literal + n.
query I
SELECT COUNT(*) FROM $planets WHERE id + 1997 IN (1999, 1999 + 1, 1999 + 2)
----
3

query I
SELECT id FROM $planets WHERE id IN (2 * 2, 10 - 1, NULL) ORDER BY id
----
4
9

query I
SELECT id FROM $planets WHERE id NOT IN (1 + 1, 3) ORDER BY id
----
1
4
5
6
7
8
9

# A NULL member makes every non-match NULL, so nothing survives — literal or folded.
query I
SELECT COUNT(*) FROM $planets WHERE id NOT IN (1 + 1, NULL)
----
0

query I
SELECT COUNT(*) FROM $planets WHERE id NOT IN (1 + 1, CAST(NULL AS INTEGER) + 1)
----
0

query T
SELECT name FROM $planets WHERE name IN ('Earth', 'Ma' || 'rs') ORDER BY name
----
Earth
Mars

# A folded element of another type is still a mixed-type list.
statement error ArrayWithMixedTypesError
SELECT id FROM $planets WHERE id IN (1, 'a' || 'b')
