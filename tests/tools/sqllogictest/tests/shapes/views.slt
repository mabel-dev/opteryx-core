# Source: test_views.py

# Known starting state: neither view exists before this file's assertions run.
statement ok
DROP VIEW IF EXISTS ws.views.test_01

statement ok
DROP VIEW IF EXISTS ws.views.test_02

statement ok
DROP VIEW IF EXISTS ws.views.nonexistent_view

statement ok
CREATE VIEW ws.views.test_01 AS SELECT * FROM $planets

# `radius` used to stand where `diameter` does: $planets has no such column, and the
# definition was accepted because nothing bound a view body. CREATE VIEW now binds one to
# record the view's schema, so a body naming a column that does not exist is refused here
# instead of at every read.
statement ok
CREATE OR REPLACE VIEW ws.views.test_02 (col1, col2, col3) AS SELECT name, mass, diameter FROM $planets

query shape 1 2
SHOW CREATE VIEW ws.views.test_01

# Read THROUGH the view. Until this was added, no test in the suite ever selected from a
# view — only DDL and SHOW CREATE VIEW — which is why views being entirely unreadable on
# this connector (a shadowed `eidetic` capability flag) went unnoticed.
query shape 9 20
SELECT * FROM ws.views.test_01

query shape 4 20
SELECT * FROM ws.views.test_01 WHERE id < 5

# A view whose body carries a subquery. The subquery must be eliminated by the Plan
# Rewriter; when view bodies were expanded after the rewriter had run, this reached the
# expression compiler and died with "unsupported node type 39".
statement ok
CREATE OR REPLACE VIEW ws.views.test_03 AS SELECT id, name FROM $planets AS p WHERE p.id IN (SELECT q.id FROM $planets AS q WHERE q.id < 5)

query shape 4 2
SELECT * FROM ws.views.test_03

# A view whose body carries a CTE — the view's own CTEs used to be discarded, leaving a
# scan of a relation that did not exist.
statement ok
CREATE OR REPLACE VIEW ws.views.test_04 AS WITH small AS (SELECT id, name FROM $planets WHERE id < 5) SELECT * FROM small

query shape 4 2
SELECT * FROM ws.views.test_04

# A view built on another view.
statement ok
CREATE OR REPLACE VIEW ws.views.test_05 AS SELECT name FROM ws.views.test_04

query shape 4 1
SELECT * FROM ws.views.test_05

statement ok
DROP VIEW ws.views.test_05

statement ok
DROP VIEW ws.views.test_04

statement ok
DROP VIEW ws.views.test_03

statement ok
ALTER VIEW ws.views.test_01 AS SELECT name, mass FROM $planets WHERE mass > 5e24

query shape 1 2
SHOW CREATE VIEW ws.views.test_01

statement ok
DROP VIEW ws.views.test_02

statement ok
DROP VIEW ws.views.test_01

# A view over a relation that does not exist is no longer creatable: its shape cannot be
# determined, and a view nobody can be told the shape of is not recorded. This used to be
# accepted and fail only when somebody read it.
statement error DatasetNotFoundError
CREATE VIEW ws.views.test_01 AS SELECT * FROM nonexistent_table

# ALTER VIEW on a name that is not yet a view still defines one - what has to bind is the
# BODY, and this body binds.
statement ok
ALTER VIEW ws.views.nonexistent_view AS SELECT * FROM $planets

statement ok
DROP VIEW ws.views.nonexistent_view

# Outer-relation references in a view body must survive the view's relations being
# renamed on expansion: an alias read from inside a correlated subquery (TPC-H Q4/Q21),
# and a bare table name qualifying a column of `testdata.planets` (TPC-H Q16), both
# outside and inside a subquery. Each read used to fail "Dataset `p` is referenced in
# the query, but it does not appear in a FROM or JOIN clause".
statement ok
CREATE OR REPLACE VIEW ws.views.outer_alias AS SELECT p.id FROM testdata.planets AS p WHERE EXISTS (SELECT * FROM testdata.satellites WHERE planetId = p.id)

query shape 7 1
SELECT * FROM ws.views.outer_alias

statement ok
CREATE OR REPLACE VIEW ws.views.bare_name AS SELECT id FROM testdata.planets WHERE planets.id < 4

query shape 3 1
SELECT * FROM ws.views.bare_name

statement ok
CREATE OR REPLACE VIEW ws.views.bare_name_in_subquery AS SELECT id FROM testdata.planets WHERE EXISTS (SELECT * FROM testdata.satellites WHERE planetId = planets.id)

query shape 7 1
SELECT * FROM ws.views.bare_name_in_subquery

# A body whose CTE is referenced twice (a shared CTE, TPC-H Q11/Q15/Q22). Binding the
# body to record the view's schema left its manifest-less shared CTEs in the CREATE's
# own plan, and CREATE failed "Scans require a file manifest".
statement ok
CREATE OR REPLACE VIEW ws.views.shared_cte AS WITH a AS (SELECT id FROM testdata.planets), b AS (SELECT MAX(id) AS m FROM a) SELECT id FROM a, b WHERE id = m

query shape 1 1
SELECT * FROM ws.views.shared_cte

statement ok
DROP VIEW ws.views.outer_alias

statement ok
DROP VIEW ws.views.bare_name

statement ok
DROP VIEW ws.views.bare_name_in_subquery

statement ok
DROP VIEW ws.views.shared_cte

# Leave a clean workspace for the next run of this file. IF EXISTS because the CREATE
# above is now refused, so test_01 is already gone.
statement ok
DROP VIEW IF EXISTS ws.views.test_01

