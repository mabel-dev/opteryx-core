                    "example": "date_col::TIMESTAMP",
                    "note": "Fills time as midnight (00:00:00)"
                },
                {
                    "type": "from INTEGER (seconds)",
                    "example": "epoch_col::TIMESTAMP[s]",
                    "note": "Seconds since Unix epoch"
                },
                {
                    "type": "from INTEGER (milliseconds)",
                    "example": "epoch_col::TIMESTAMP[ms]",
                    "note": "Milliseconds since Unix epoch"
                },
                {
                    "type": "from INTEGER (microseconds)",
                    "example": "epoch_col::TIMESTAMP[us]",
                    "note": "Microseconds since Unix epoch (default scale)"
                },
