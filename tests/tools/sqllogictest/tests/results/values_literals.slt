# VALUES cells and DECIMAL128 values read back exactly (2026-11-15).
#
# - A VALUES cell that is an expression (CAST, arithmetic) died at bind with
#   "'Cast' object has no attribute 'type'": every consumer read cells as literals.
#   Cells are now folded natively at bind; one that does not reduce to a single value
#   is refused.
# - A DECIMAL VALUES column was built at DECIMAL(18, 6) whatever it was bound as, and a
#   DECIMAL128 one (a large integer literal) had no constructor at all.
# - A DECIMAL128 value past 28 significant digits read back into Python rounded to 28
#   (Python's default decimal context): 38 nines came back as 1.000...E+38.
# A written real literal is FLOAT64 by design (ruled 2026-08-04); exactness is a CAST.

# a large integer literal is a DECIMAL128 column
query T
SELECT CAST(v AS VARCHAR) FROM (VALUES (99999999999999999999)) AS t(v)
----
99999999999999999999

# CAST cells, at the column's own precision and scale
query T
SELECT CAST(v AS VARCHAR) FROM (VALUES (CAST('999999999999999999.99' AS DECIMAL(20,2))), (CAST('1.25' AS DECIMAL(20,2)))) AS t(v) ORDER BY v
----
1.25
999999999999999999.99

query T
SELECT CAST(v AS VARCHAR) FROM (VALUES (CAST('9000000000000.00' AS DECIMAL(15,2))), (CAST('1.25' AS DECIMAL(15,2)))) AS t(v) ORDER BY v
----
1.25
9000000000000.00

# a constant expression cell
query IT
SELECT v, s FROM (VALUES (1 + 2, 'a')) AS t(v, s)
----
3 a

# a cell that is not one value is refused
statement error (?s).*does not reduce to a single value.*
SELECT * FROM (VALUES (RANDOM())) AS t(v)

# 38 digits read back exactly: the VALUES cell is folded natively and read back
# into a literal (this driver renders a DECIMAL through float, so it is shown as text;
# the readback itself is covered by tests/unit/draken/test_decimal128_readback.py)
query T
SELECT CAST(v AS VARCHAR) FROM (VALUES (CAST('99999999999999999999999999999999999999' AS DECIMAL(38,0)))) AS t(v)
----
99999999999999999999999999999999999999

# INSERT ... VALUES with CAST cells (the same VALUES binding) into a real table
statement ok
CREATE TABLE cat.wt.values_dec AS SELECT CAST('0.00' AS DECIMAL(20,2)) AS d

statement ok
INSERT INTO cat.wt.values_dec VALUES (CAST('999999999999999999.99' AS DECIMAL(20,2)))

query T
SELECT CAST(d AS VARCHAR) FROM cat.wt.values_dec ORDER BY d
----
0.00
999999999999999999.99

# ---- a VALUES column's type represents EVERY row, not just the first ----------------
#
# The column took the FIRST row's type, so a later row it could not hold was refused
# (or, across families, read back as a wrong value). Rows unify as CASE branches do:
# within one family (all numeric/DECIMAL, all string, all DATE, ...), sized to hold each
# row; across families the statement is refused.

query T
SELECT CAST(v AS VARCHAR) FROM (VALUES (CAST('1.25' AS DECIMAL(10,2))), (99999999999999999999)) AS t(v) ORDER BY v
----
1.25
99999999999999999999.00

query T
SELECT CAST(v AS VARCHAR) FROM (VALUES (CAST('1.5' AS DECIMAL(3,1))), (7)) AS t(v) ORDER BY v
----
1.5
7.0

query R
SELECT v FROM (VALUES (1), (2.5)) AS t(v) ORDER BY v
----
1.000
2.500

query T
SELECT v FROM (VALUES (NULL), ('x')) AS t(v) ORDER BY v
----
NULL
x

statement error (?s).*IncompatibleTypesError.*every row of a column must share a compatible type.*
SELECT * FROM (VALUES ('a'), (1)) AS t(v)

statement error (?s).*IncompatibleTypesError.*every row of a column must share a compatible type.*
SELECT * FROM (VALUES (CAST('2026-01-02' AS DATE)), (CAST('2026-03-04 05:06:07' AS TIMESTAMP))) AS t(v)

# INSERT ... VALUES type-checks the unified column, and writes every row
statement ok
CREATE TABLE cat.wt.values_mixed AS SELECT CAST('0.0' AS DECIMAL(10,1)) AS d

statement ok
INSERT INTO cat.wt.values_mixed VALUES (CAST('1.5' AS DECIMAL(3,1))), (7)

query T
SELECT CAST(d AS VARCHAR) FROM cat.wt.values_mixed ORDER BY d
----
0.0
1.5
7.0

# ---- a literal list's elements are values, never an expression's attributes ---------
#
# `(CAST('1.25' AS DECIMAL(10,2)), ...)` read each element's `.value` - a CAST's
# TARGET TYPE NAME - and became ('DECIMAL', 'DECIMAL'), typed ARRAY<VARIANT>.

query T
SELECT CAST(v AS VARCHAR) FROM UNNEST((CAST('1.25' AS DECIMAL(10,2)), CAST('3.50' AS DECIMAL(10,2)))) AS v ORDER BY v
----
1.25
3.50

query IT
SELECT p.id, CAST(x AS VARCHAR) FROM $planets AS p CROSS JOIN UNNEST((CAST('1.25' AS DECIMAL(10,2)), CAST('3.50' AS DECIMAL(10,2)))) AS x WHERE p.id = 1 ORDER BY x
----
1 1.25
1 3.50

query I
SELECT v FROM UNNEST((1 + 1, 5)) AS v ORDER BY v
----
2
5

statement error (?s).*does not reduce to a single value.*
SELECT * FROM UNNEST((RANDOM(), 1)) AS v
