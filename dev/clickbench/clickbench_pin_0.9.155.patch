diff -ruN a/opteryx/stop b/opteryx/stop
--- a/opteryx/stop	2026-10-04 14:14:31
+++ b/opteryx/stop	2026-10-04 17:57:41
@@ -1,2 +1,12 @@
 #!/bin/bash
+# The driver waits for ./check to fail after this, so the process must be gone,
+# not just signalled.
+if [ -f server.pid ]; then
+    pid=$(cat server.pid)
+    kill "$pid" 2>/dev/null || true
+    while kill -0 "$pid" 2>/dev/null; do
+        sleep 0.1
+    done
+    rm -f server.pid
+fi
 exit 0
