# Source: power_bi.run_tests

# these are the queries issued by PowerBI when it first connects to a MySQL database

statement ok
SELECT @@max_allowed_packet, @@character_set_client, @@character_set_connection, @@license, @@sql_mode, @@lower_case_table_names, @@autocommit


statement error InvalidFunctionParameterError
SELECT TIMEDIFF(NOW(), UTC_TIMESTAMP())


