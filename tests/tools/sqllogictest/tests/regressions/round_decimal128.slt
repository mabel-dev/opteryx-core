# ROUND/FLOOR/CEILING over DECIMAL128 (precision > 18) failed with "DECIMAL128
# operand (precision > 18) is not supported by this kernel" — TPC-DS Q02 rounds a
# DECIMAL / DECIMAL division. They round exactly in the int128 domain (2.675 -> 2.68,
# where double-domain rounding gives 2.67).

query RRR
SELECT ROUND(CAST(2.675 AS DECIMAL(30,3)), 2), ROUND(CAST(-2.675 AS DECIMAL(30,3)), 2), ROUND(CAST(125.5 AS DECIMAL(30,1)), -1)
----
2.680 -2.680 130.000

query RR
SELECT FLOOR(CAST(-2.675 AS DECIMAL(30,3))), CEIL(CAST(-2.675 AS DECIMAL(30,3)))
----
-3.000 -2.000

query R
SELECT ROUND(CAST(1.5 AS DECIMAL(20,2)) / CAST(0.7 AS DECIMAL(20,2)), 2)
----
2.140

statement error rounding step exceeds the int128 decimal domain
SELECT ROUND(CAST(1 AS DECIMAL(38,0)), -40)
